# ---- Harakumo (one key for everything: https://harakumo.com/dashboard/settings) ----
HARAKUMO_API_KEY=hk_live_xxx
HARAKUMO_BASE_URL=https://harakumo.com
# Filled automatically by `npm run harakumo:setup`:
HARAKUMO_PROJECT_ID=
HARAKUMO_DATABASE_ID=
HARAKUMO_BUCKET_ID=
HARAKUMO_PAYMENTS_ACCOUNT_ID=
HARAKUMO_PAYMENTS_ONBOARDING_URL=
HARAKUMO_AUTH_POOL_ID=
HARAKUMO_AI_ENABLED=true

# ---- App ----
APP_NAME=Fruitly
APP_URL=http://localhost:3000
AUTH_SECRET=change-me-generate-a-long-random-string
ADMIN_EMAILS=you@example.com
SESSION_DAYS=30
OTP_TTL_MINUTES=10

# ---- Mail: "harakumo" (real email via Harakumo Mail) or "dev" (console + /dev/mailbox) ----
MAIL_MODE=harakumo
MAIL_DEV_MAILBOX=true

# ---- Commerce ----
CURRENCY=USD
TAX_RATE=0
FREE_SHIPPING_OVER_CENTS=5000
SHIPPING_FLAT_CENTS=599
COD_ENABLED=true

# ---- Local fulfilment (delivery zone + pickup) ----
DELIVERY_AREA_NAME=Your town
# Comma-separated postal codes you deliver to. Empty = anywhere.
DELIVERY_ZIPS=
DELIVERY_ZONE_NOTE=
# Weekday:startHour-endHour (24h), comma separated
DELIVERY_SLOTS=Tue:17-20,Thu:17-20,Sat:10-13
DELIVERY_SLOT_WEEKS=2
# Only enable if you have a physical place customers can collect from
PICKUP_ENABLED=false
PICKUP_LOCATION=
PICKUP_NOTE=
# "stocked" = you hold inventory; "made_to_order" = you buy each order after it's placed
INVENTORY_MODE=stocked
SERVICE_FEE_CENTS=0
PAYMENTS_TRUST_SUCCESS_REDIRECT=false
PAYMENTS_WEBHOOK_SECRET=

# ---- Local fallback DB (used only when HARAKUMO_* is not set) ----
LOCAL_DB_PATH=data/fruitly.local.db
